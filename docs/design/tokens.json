{
  "$description": "Teamable — projekt UI „Identyfikator” (ADR-0008). Wartości z kodu: frontend/src/assets/main.css i klasy Tailwind w komponentach. Format: W3C Design Tokens (DTCG). Import do Figmy: docs/design/README.md.",
  "color": {
    "light": {
      "wall": {
        "$type": "color",
        "$value": "#e4e8f1",
        "$description": "Tło strony (ściana biura)"
      },
      "badge": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Identyfikator, karty, tekst na przycisku głównym"
      },
      "ink": {
        "$type": "color",
        "$value": "#18204a",
        "$description": "Tekst, przycisk główny, klips"
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#5a6386",
        "$description": "Tekst drugorzędny, ramki przy najechaniu"
      },
      "lanyard": {
        "$type": "color",
        "$value": "#ffc53d",
        "$description": "Smycz i pasek profilu — jedyny akcent"
      },
      "lanyard-ink": {
        "$type": "color",
        "$value": "#3b2a00",
        "$description": "Tekst na żółtym pasku"
      },
      "line": {
        "$type": "color",
        "$value": "#d3d9e8",
        "$description": "Ramki pól i kart, linia przerywana"
      },
      "field": {
        "$type": "color",
        "$value": "#f3f5fa",
        "$description": "Tło pól formularza, awatar bez zdjęcia"
      },
      "error": {
        "$type": "color",
        "$value": "#b3261e",
        "$description": "Tekst i ramka błędu"
      },
      "error-bg": {
        "$type": "color",
        "$value": "#fdecea",
        "$description": "Tło komunikatu błędu"
      },
      "focus": {
        "$type": "color",
        "$value": "#2d4fd6",
        "$description": "Obrys fokusu klawiatury"
      },
      "shadow": {
        "$type": "color",
        "$value": "rgb(24 32 74 / 0.16)",
        "$description": "Cień identyfikatora"
      }
    },
    "dark": {
      "wall": {
        "$type": "color",
        "$value": "#121831",
        "$description": "Tło strony (ściana biura)"
      },
      "badge": {
        "$type": "color",
        "$value": "#1d2443",
        "$description": "Identyfikator, karty, tekst na przycisku głównym"
      },
      "ink": {
        "$type": "color",
        "$value": "#e8ecf8",
        "$description": "Tekst, przycisk główny, klips"
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#a3abcb",
        "$description": "Tekst drugorzędny, ramki przy najechaniu"
      },
      "lanyard": {
        "$type": "color",
        "$value": "#ffcc4d",
        "$description": "Smycz i pasek profilu — jedyny akcent"
      },
      "lanyard-ink": {
        "$type": "color",
        "$value": "#2e2100",
        "$description": "Tekst na żółtym pasku"
      },
      "line": {
        "$type": "color",
        "$value": "#333c63",
        "$description": "Ramki pól i kart, linia przerywana"
      },
      "field": {
        "$type": "color",
        "$value": "#262e52",
        "$description": "Tło pól formularza, awatar bez zdjęcia"
      },
      "error": {
        "$type": "color",
        "$value": "#ff9b8f",
        "$description": "Tekst i ramka błędu"
      },
      "error-bg": {
        "$type": "color",
        "$value": "#3a1d24",
        "$description": "Tło komunikatu błędu"
      },
      "focus": {
        "$type": "color",
        "$value": "#9db0ff",
        "$description": "Obrys fokusu klawiatury"
      },
      "shadow": {
        "$type": "color",
        "$value": "rgb(0 0 0 / 0.45)",
        "$description": "Cień identyfikatora"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque Variable",
          "Avenir Next",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Imiona, nagłówki, nazwa marki (OFL)"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible",
          "Verdana",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Tekst, formularze (OFL)"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800
      }
    }
  },
  "typography": {
    "name-desktop": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2.35rem",
        "fontWeight": 800,
        "lineHeight": 1.02,
        "letterSpacing": "-0.025em"
      },
      "$description": "Imię i nazwisko na identyfikatorze (≥ 640 px)"
    },
    "name-mobile": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2rem",
        "fontWeight": 800,
        "lineHeight": 1.02,
        "letterSpacing": "-0.025em"
      },
      "$description": "Imię i nazwisko (< 640 px)"
    },
    "heading-desktop": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2.1rem",
        "fontWeight": 800,
        "lineHeight": 1.05,
        "letterSpacing": "-0.025em"
      },
      "$description": "„Zaloguj się do zespołu” (≥ 640 px)"
    },
    "heading-mobile": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "1.85rem",
        "fontWeight": 800,
        "lineHeight": 1.05,
        "letterSpacing": "-0.025em"
      },
      "$description": "Nagłówki formularzy (< 640 px; edycja zawsze)"
    },
    "wordmark": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "1.35rem",
        "fontWeight": 800,
        "lineHeight": 1,
        "letterSpacing": "-0.025em"
      },
      "$description": "Nazwa „Teamable” w nagłówku"
    },
    "initials": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2.25rem",
        "fontWeight": 800,
        "lineHeight": 1.11,
        "letterSpacing": "0em"
      },
      "$description": "Inicjały w awatarze bez zdjęcia"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1rem",
        "fontWeight": 700,
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      },
      "$description": "Etykiety pól"
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1.02rem",
        "fontWeight": 700,
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      },
      "$description": "Przycisk „Zaloguj”"
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.875rem",
        "fontWeight": 400,
        "lineHeight": 1.43,
        "letterSpacing": "0em"
      },
      "$description": "Stopka formularza, e-mail w nagłówku, status"
    }
  },
  "radius": {
    "badge": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Identyfikator"
    },
    "button-primary": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "„Zaloguj”"
    },
    "control": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Pola, przyciski, komunikaty (rounded-xl)"
    },
    "header-button": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "„Wyloguj”"
    },
    "clip": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Klips smyczy (dół 10px)"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Awatar, otwór na smycz"
    }
  },
  "size": {
    "badge-width": {
      "$type": "dimension",
      "$value": "400px",
      "$description": "Maks. szerokość identyfikatora"
    },
    "avatar": {
      "$type": "dimension",
      "$value": "104px",
      "$description": "Awatar na karcie (size-26)"
    },
    "avatar-edit": {
      "$type": "dimension",
      "$value": "80px",
      "$description": "Podgląd w edycji"
    },
    "control-height": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Min. wysokość pól (min-h-12)"
    },
    "button-primary-height": {
      "$type": "dimension",
      "$value": "52px",
      "$description": "„Zaloguj” (min-h-13)"
    },
    "button-height": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Pozostałe przyciski — cel dotyku (min-h-11)"
    },
    "lanyard-ribbon": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Szerokość taśmy smyczy"
    },
    "focus-outline": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "Grubość obrysu fokusu"
    }
  },
  "space": {
    "badge-x-mobile": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Wewnętrzny margines identyfikatora (< 640 px)"
    },
    "badge-x": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "(≥ 640 px)"
    },
    "badge-top": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Od góry karty do nagłówka (pod otworem)"
    },
    "field-gap": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Odstęp między polami"
    },
    "label-gap": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Etykieta → pole"
    },
    "page-gutter": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Margines boczny strony"
    }
  },
  "shadow": {
    "badge": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.light.line}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px"
        },
        {
          "color": "{color.light.shadow}",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "40px",
          "spread": "-18px"
        }
      ]
    }
  },
  "motion": {
    "flip-out": {
      "$type": "transition",
      "$value": {
        "duration": "220ms",
        "delay": "0ms",
        "timingFunction": [
          0.42,
          0,
          1,
          1
        ]
      },
      "$description": "Obrót identyfikatora: znikanie (ease-in)"
    },
    "flip-in": {
      "$type": "transition",
      "$value": {
        "duration": "380ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "Obrót: pojawienie się"
    },
    "settle": {
      "$type": "transition",
      "$value": {
        "duration": "900ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "Wychylenie przy wejściu; przy prefers-reduced-motion brak animacji"
    }
  }
}
