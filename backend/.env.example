# Port serwera HTTP (domyślnie 3001)
PORT=3001
# Katalog danych: uploads/ ze zdjęciem avatara (domyślnie ./data)
PROFILE_DATA_DIR=
# Połączenie z MongoDB (dev: docker compose up -d)
MONGODB_URI=mongodb://localhost:27017
# Sekret Better Auth (min. 32 znaki): openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adres, pod którym przeglądarka widzi aplikację (dev: proxy Vite)
BETTER_AUTH_URL=http://localhost:5173
# Opcjonalne konto demo
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
